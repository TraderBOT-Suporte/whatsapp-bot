# ═══════════════════════════════════════════════════════════
# PAINEL DE SINAIS — Main Server
# ═══════════════════════════════════════════════════════════

# Porta (Render define automaticamente em produção)
PORT=3000

# ─── FIREBASE (Firestore para dados) ──────────────────────
# JSON da conta de serviço, inteiro numa linha só
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ─── WEB PUSH (VAPID) ─────────────────────────────────────
# Gera com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:teu-email@exemplo.com

# ─── API DE ANÁLISE (servidor externo que analisa indicadores) ──
# URL completa SEM barra no fim
ANALYSIS_API_URL=https://deriv-trading-backend-w2vx.onrender.com

# ⭐ TEM DE SER IGUAL ao ADMIN_SECRET do servidor de análise
ADMIN_SECRET=chave-secreta-muito-longa-e-aleatoria-aqui

# ─── CORS (opcional) ──────────────────────────────────────
# CORS_ORIGINS=https://painel-sinais.onrender.com,http://localhost:3000

# ─── PREENCHIDO AUTOMATICAMENTE PELO RENDER ───────────────
RENDER_EXTERNAL_URL=

# ─── LOGS (opcional) ──────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info